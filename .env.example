# Banco criptografado principal
DB_TYPE=real
DB_REAL_PATH=database/patients.db

# Limite a porta 8080 à sub-rede da clínica no firewall.
API_HOST=0.0.0.0
API_PORT=8080

# Opcional: informe um banco existente quando a descoberta automática encontrar mais de um.
# DB_MIGRATION_SOURCE=database/importacao/patients.db

# Opcional: callback usado ao vincular o Google Drive no próprio computador servidor.
OAUTH_REDIRECT_URI=http://localhost:8080/oauth-callback
